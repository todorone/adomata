# Postgres connection. Matches the root docker-compose.yml `db` service defaults.
DATABASE_URL=postgres://adomata:adomata@localhost:5432/adomata

PORT=3000
BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# No safe default — generate a long random string before running locally.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Meta mode is deliberately explicit. Fake mode intercepts Graph API requests locally.
META_API_MODE=fake
# Fake-mode placeholder only. Live mode resolves each Agency's own token from
# organizationSettings (see the Organization Settings page) — this is unused there.
META_ACCESS_TOKEN=
# No safe default — generate a long random string before running locally.
HEARTBEAT_SECRET=replace-with-a-long-random-heartbeat-secret

# This email can bootstrap access without an invitation.
SUPERADMIN_EMAIL=super@adomata.com

# Client app origin. Used to build links (e.g. the invitation-accept redirect).
CLIENT_URL=http://localhost:3000

# Invitation email delivery via the Cloudflare Email Service REST API.
# If any of these are unset, sending is logged and skipped (invitations are still created).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM=Adomata <noreply@adomata.com>

# Optional social sign-in. Unset means the provider is omitted, not broken.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Telemetry (traces + logs) via OTLP/HTTP, read automatically by the OTel SDK.
# Only active when NODE_ENV=production (see core/telemetry.ts) — unset locally.
OTEL_EXPORTER_OTLP_ENDPOINT=https://telemetry.fedir.net
# TODO: confirm the auth header format telemetry.fedir.net expects, e.g. for
# OpenObserve this is typically `Authorization=Basic <base64(email:password)>`.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=adomata-api
