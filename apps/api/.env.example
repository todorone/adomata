# Postgres connection. Matches the root docker-compose.yml `db` service defaults.
DATABASE_URL=postgres://adomata:adomata@localhost:5432/adomata

PORT=3000
BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# No safe default — generate a long random string before running locally.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# This email can bootstrap access without an invitation.
SUPERADMIN_EMAIL=pmahotsava@gmail.com

# Dashboard origin. Used to build links (e.g. the invitation-accept redirect).
DASHBOARD_URL=http://localhost:3000

# Invitation email delivery via the Cloudflare Email Service REST API.
# If any of these are unset, sending is logged and skipped (invitations are still created).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM=Adomata <noreply@adomata.com>

# Optional social sign-in. Unset means the provider is omitted, not broken.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
