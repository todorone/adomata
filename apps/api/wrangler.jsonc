/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-21",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "adomata",
			// TODO: replace with the real D1 database id once provisioned in Cloudflare — do not reuse FrontPeek's.
			"database_id": "TODO",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "GENERAL_BUCKET",
			// TODO: create this bucket in Adomata's own Cloudflare account before deploying.
			"bucket_name": "adomata-general"
		}
	],
	"vars": {
		// TODO: confirm subdomains once the api/dashboard split is deployed.
		"BASE_URL": "https://api.adomata.com",
		"BETTER_AUTH_URL": "https://api.adomata.com",
		"DASHBOARD_URL": "https://dash.adomata.com",
		"EMAIL_FROM": "Adomata <noreply@adomata.com>",
		"SUPERADMIN_EMAIL": "pmahotsava@gmail.com"
	},
	"secrets": {
		"required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "APPLE_CLIENT_ID", "APPLE_CLIENT_SECRET"]
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	]
}
