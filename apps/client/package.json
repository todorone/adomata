{
	"name": "client",
	"private": true,
	"type": "module",
	"imports": {
		"@/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 5173",
		"build": "vite build",
		"format": "prettier \"src/**/*.{md,ts,tsx,js,mjs,json}\" --write --log-level warn",
		"format-check": "prettier \"src/**/*.{md,ts,tsx,js,mjs,json}\" --check",
		"lint": "eslint src",
		"preview": "vite preview",
		"test": "vitest run",
		"ts": "tsc",
		"e2e": "playwright test",
		"deploy": "pnpm run build && wrangler deploy"
	},
	"dependencies": {
		"@adomata/api": "workspace:*",
		"@faker-js/faker": "^10.3.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/match-sorter-utils": "latest",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "5.71.5",
		"@tanstack/react-query-devtools": "5.100.9",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-table": "latest",
		"@tanstack/router-plugin": "^1.132.0",
		"better-auth": "1.6.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "4.12.16",
		"lucide-react": "^0.577.0",
		"radix-ui": "1.4.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"zod": "4.4.2"
	},
	"devDependencies": {
		"@playwright/test": "1.61.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "latest",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^28.1.0",
		"vite": "^8.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["esbuild", "lightningcss"]
	}
}
