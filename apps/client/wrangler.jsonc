{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "client",
  "compatibility_date": "2026-05-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "VITE_API_URL=https://api.adomata.com pnpm run build"
  },
  "routes": [{ "pattern": "app.adomata.com", "custom_domain": true }],
  "vars": {
    "VITE_API_URL": "https://api.adomata.com"
  }
}
