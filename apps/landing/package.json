{
	"name": "landing",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"format": "prettier \"src/**/*.{md,ts,tsx,js,mjs,json}\" --write --log-level warn",
		"format-check": "prettier \"src/**/*.{md,ts,tsx,js,mjs,json}\" --check",
		"types": "tsc",
		"lint": "eslint src",
		"preview": "vite preview"
	},
	"dependencies": {
		"react": "19.2.0",
		"react-dom": "19.2.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.0.15",
		"@types/react": "~19.1.17",
		"@types/react-dom": "~19.1.11",
		"@vitejs/plugin-react": "4.3.4",
		"tailwindcss": "4.0.15",
		"vite": "6.2.2"
	}
}
